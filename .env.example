# Copy to .env.local and supply your own values. Never commit .env.local.
# Optional password for this single-admin panel. Restart after changing it.
HUB_PASSWORD=
# Set this to the actual origin if running behind a reverse proxy.
PUBLIC_APP_URL=
# Use false for previews/tests to avoid processing real scheduled publications.
SCHEDULER_ENABLED=true

FACEBOOK_TOKEN_OBSIDIANA=
FACEBOOK_TOKEN_FUCSIA=
FACEBOOK_TOKEN_NEUROCORTEX=

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=
# DeepSeek (API compatible con OpenAI). Clave: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Claude (Anthropic). Clave: https://platform.claude.com (se cobra por uso).
ANTHROPIC_API_KEY=
CLAUDE_API_MODEL=claude-opus-5-5
# Razonamiento: low, medium, high, xhigh o max.
# CLAUDE_API_EFFORT=medium
# Jev: motor rapido de decision (API hospedada, claves jv_live_). Clave: https://jevtypesafeai.com/typesafe/pricing
JEV_API_KEY=
# JEV_MODEL=jev-latest
# JEV_ENDPOINT=
# Busqueda web opcional para el descubrimiento (gratis, instancia propia de SearXNG).
# Sin esto, el descubrimiento sigue funcionando con Google Places y el sitio declarado.
# SEARXNG_URL=http://127.0.0.1:8080
# Descubrimiento de prospectos: Overpass (OpenStreetMap). Opcional.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
JEV_MODEL=jev-latest
# DEEPSEEK_THINKING=true habilita el razonamiento extendido del modelo.

COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_PATH=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional absolute path; default: canva-integration/server/.canva-tokens.json
CANVA_TOKENS_PATH=
GOOGLE_PLACES_KEY=

# Flyers animados: carpeta con música libre de derechos y ruta de ffmpeg (opcionales)
MOTION_MUSIC_DIR=
FFMPEG_PATH=

# Agente por Telegram (opcional). Creá el bot con @BotFather.
TELEGRAM_BOT_TOKEN=
# Ids de Telegram autorizados, separados por coma. Si está vacío, el bot te dice tu id.
TELEGRAM_ALLOWED_USERS=
# claude (recomendado) u ollama (local, gratis)
AGENT_PROVIDER=claude
# Modelo del agente; vacío = claude-sonnet-5-5, o LOCAL_LLM_MODEL con ollama
AGENT_MODEL=
# Modelo que idea los flyers del agente; vacío = el mismo del agente
AGENT_FLYER_MODEL=
# true = programa sin esperar tu aprobación en Telegram
AGENT_AUTO_APPROVE=false
# Modelo ggml de whisper.cpp para entender audios (por ejemplo ggml-large-v3-turbo-q5_0.bin)
WHISPER_MODEL_PATH=
# Modelo de Claude para los videos «a medida»; vacío = claude-opus-5-5
MOTION_CUSTOM_MODEL=
